{
  "_meta": {
    "checked_date": "2026-09-25",
    "note": "Penalties are quoted from sources, never invented. Evidence is mostly Llama-3.1 (8B/70B/405B); other families may differ.",
    "quantized_repos_rule": "Tiers: official = the model's own org; trusted = RedHatAI (vLLM maintainers, evaluated), hugging-quants, casperhansen (AutoAWQ author); community = anyone else, included only with 50k+ downloads in the last 30 days. 'stored_as' is the repo's quantization_config: RedHatAI w4a16 repos are GPTQ-quantized and stored as compressed-tensors; cyankiwi AWQ repos are AWQ-quantized and stored as compressed-tensors. vLLM auto-detects all of these, so the command only swaps the model id (no --quantization flag). fp8 entries are optional: online --quantization fp8 works from BF16 on fp8 GPUs. Checked 2026-09-25.",
    "int4_rule": "int4 is the repo the page uses for INT4: Google's official QAT checkpoint for Gemma 4 31B; otherwise official before trusted before community, then most downloads. Natively quantized models (FP8, MXFP4) have none, because they only run in their published format. publisher 'community' is shown on the page as (community quant)."
  },
  "quant_penalty": [
    {
      "id": "fp16",
      "name": "FP16 / BF16",
      "label": "baseline (full quality)",
      "quote": "Reference precision. All recovery figures below are measured against BF16.",
      "selectable": true,
      "sources": [
        {
          "title": "Kurtic et al., \"Give Me BF16 or Give Me Death\"? Accuracy-Performance Trade-Offs in LLM Quantization (arXiv 2411.02355)",
          "url": "https://arxiv.org/abs/2411.02355",
          "checked_date": "2026-09-25"
        }
      ]
    },
    {
      "id": "fp8",
      "name": "FP8 (W8A8-FP)",
      "label": "about lossless",
      "quote": "FP8 (W8A8-FP) is effectively lossless across all model scales. Open LLM Leaderboard v1 recovery: 99.31% (8B), 99.72% (70B), 100.12% (405B).",
      "selectable": true,
      "sources": [
        {
          "title": "Kurtic et al., arXiv 2411.02355 (abstract + Table 2)",
          "url": "https://arxiv.org/abs/2411.02355",
          "checked_date": "2026-09-25"
        },
        {
          "title": "Red Hat Developer: We ran over half a million evaluations on quantized LLMs",
          "url": "https://developers.redhat.com/articles/2024/10/17/we-ran-over-half-million-evaluations-quantized-llms",
          "checked_date": "2026-09-25"
        }
      ]
    },
    {
      "id": "int8",
      "name": "INT8 (W8A8-INT)",
      "label": "small loss (1-3%)",
      "quote": "Well-tuned INT8 (W8A8-INT) achieves surprisingly low (1-3%) accuracy degradation per task on average.",
      "selectable": false,
      "sources": [
        {
          "title": "Kurtic et al., arXiv 2411.02355",
          "url": "https://arxiv.org/abs/2411.02355",
          "checked_date": "2026-09-25"
        }
      ]
    },
    {
      "id": "int4-gptq",
      "name": "INT4 GPTQ (W4A16)",
      "label": "small loss, most noticeable on small models",
      "quote": "INT4 weight-only (W4A16-INT) is more competitive than expected, rivaling 8-bit quantization. Open LLM Leaderboard v1 recovery: 98.72% (8B), 99.53% (70B), 99.98% (405B). Coding (HumanEval): 4-bit models recover 98.9%.",
      "selectable": true,
      "sources": [
        {
          "title": "Kurtic et al., arXiv 2411.02355 (abstract + Table 2, W4A16 via GPTQ)",
          "url": "https://arxiv.org/abs/2411.02355",
          "checked_date": "2026-09-25"
        },
        {
          "title": "Frantar et al., GPTQ: Accurate Post-Training Quantization for Generative Pre-trained Transformers (arXiv 2210.17323)",
          "url": "https://arxiv.org/abs/2210.17323",
          "checked_date": "2026-09-25"
        }
      ]
    },
    {
      "id": "int4-awq",
      "name": "INT4 AWQ (W4A16)",
      "label": "small loss, a bit more than GPTQ on real tasks",
      "quote": "Near-identical to GPTQ on academic benchmarks (AWQ leads by 0.23 and 0.35 points), but GPTQ outperforms AWQ on real-world tasks by 2.9 points (8B) and 0.8 points (70B) on a 0-100 scale. The AWQ authors report it beats prior 4-bit methods on their benchmarks.",
      "selectable": true,
      "sources": [
        {
          "title": "Kurtic et al., arXiv 2411.02355 (Section 3, Table 1)",
          "url": "https://arxiv.org/abs/2411.02355",
          "checked_date": "2026-09-25"
        },
        {
          "title": "Lin et al., AWQ: Activation-aware Weight Quantization for LLM Compression and Acceleration (MLSys 2024, arXiv 2306.00978)",
          "url": "https://arxiv.org/abs/2306.00978",
          "checked_date": "2026-09-25"
        }
      ]
    }
  ],
